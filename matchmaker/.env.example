# matchmaker/.env  — copy this file to `.env` and fill it in yourself.
# Claude never reads or writes real values here; .env is gitignored.

# Encourt's Playtomic MANAGER login (the account that can post in match chats).
PLAYTOMIC_EMAIL=
PLAYTOMIC_PASSWORD=

# Encourt tenant id (already known — leave as is).
PLAYTOMIC_TENANT_ID=<TENANT_ID>

# Fallback only: if headless login is blocked, paste a refresh token captured
# once from the logged-in browser. Leave blank while headless login works.
PLAYTOMIC_REFRESH_TOKEN=

# Dashboard port (own port, separate from jarvis:4870).
PORT=4880
